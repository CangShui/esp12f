# =============================================================================
#  ES12F 本地化固件 —— Git 忽略规则
# =============================================================================

# 第三方工具链（约 464MB）。可整体删除；重新编译时需联网重新下载。
# 若你希望把工具链也纳入版本管理，删掉这一行即可（注意 GitHub 单文件 100MB 限制）。
/toolchain/

# 临时编译产物（由 tools/build.ps1 生成）
/build/

# 运行日志（由 tools/*.py 生成）
/logs/

# Python
__pycache__/
*.py[cod]

# 系统 / 编辑器
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~
.idea/
.vscode/

# 刷写过程中产生的全片转储（可能含设备配置，不要提交）
current_flash_backup_*.bin
